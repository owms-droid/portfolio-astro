---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/header/Header.astro';
import { menuBlog } from '../components/data/menuData';
type Props = CollectionEntry<'blog'>['data'];
const { title, pubDate }: Props = Astro.props;
import '../styles/global.css';
import Footer from '../components/Footer/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="owiDev Blog" />
		<meta name="viewport" content="width=device-width" />
		<link
			rel="icon"
			type="image/svg+xml"
			href="../../img/owidev-logo.png"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta http-equiv="Content-Type" content="text/html;charset=UTF-8" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

		<title>{title}</title>
	</head>
	<body>
		<Header origin={menuBlog} name="Oliver M." />
		<main class="w-full flex flex-col justify-center items-center pt-[13rem]">
			<div class="text-center">
				<h1 class="text-4xl text-center font-extrabold color__gradiente mb-3">
					{title}
				</h1>
				<FormattedDate date={pubDate} clase="text-white text-2xl  " />
			</div>
			<section class="blog-content flex flex-col md:max-w-[57%] max-w-[100%] min-w-[30rem] px-5 pt-10 pb-[3rem] justify-center w-[80%]">
				<slot />
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	.blog-content :global(p) {
		font-size: 1.8rem;
	}
	.blog-content :global(p:has(> img)) {
		display: flex;
		justify-content: center;
	}
	.blog-content :global(p > img) {
		width: 100%;
		max-width: 80rem;
		min-width: 27rem;
	}
	.blog-content :global(h2),
	.blog-content :global(h3),
	.blog-content :global(h4),
	.blog-content :global(h5),
	.blog-content :global(h6) {
		color: white;
		font-weight: 700;
		margin: 2rem 0;
	}
	.blog-content :global(h2) {
		font-size: var(--text-xx-large);
	}
	.blog-content :global(h3) {
		font-size: var(--text-x-large);
	}
	.blog-content :global(h4) {
		font-size: var(--text-large);
	}
	.blog-content :global(pre) {
		font-size: 1.8rem;
		padding: 1rem;
		margin: 3rem 0;
		border-radius: 0.5rem;
	}
	@media screen and (max-width: 768px) {
		.blog-content :global(h2) {
			font-size: 2rem;
		}
	}
</style>
