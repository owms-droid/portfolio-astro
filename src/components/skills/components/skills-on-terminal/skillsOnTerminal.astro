---
import TerminalIcon from '../../atoms/terminal-icon/TerminalIcon.astro';
import Terminal from '../terminal/Terminal.astro';
---

<Terminal nombre="oliverModesto">
	<div class="terminal__skills">
		<h2>My skills</h2>
		<div class="terminal__skills__container">
			<TerminalIcon src="/assets/html.svg" color="#F06529" name="HTML" />
			<TerminalIcon src="/assets/css.svg" color="#00A3FF" name="CSS" />
			<TerminalIcon
				src="/assets/javascript.svg"
				color="#f0db4f"
				name="JavaScript"
			/>
			<TerminalIcon
				src="/assets/mysql.svg"
				color="#00758F "
				name="MySQL"
			/>
			<TerminalIcon
				src="/assets/Astro.svg"
				color="#FF5D8F"
				name="Astro"
			/>
			<TerminalIcon
				src="/assets/wordpress.svg"
				color="#00749c"
				name="WordPress"
			/>
		</div>
	</div>
</Terminal>

<style>
	.terminal__skills__container {
		display: flex;
		flex-wrap: wrap;
		width: 100%;
		justify-content: center;
		gap: 2.2rem;
	}
	.terminal__skills {
		padding: 2.2rem 0;
		width: 100%;
		display: flex;
		justify-content: center;
		align-items: center;
		flex-direction: column;
	}
	.terminal__skills h2 {
		font-size: var(--text-xx-large);
		font-weight: 600;
		color: var(--secondary-90);
		padding: 2.2rem 0;
	}
</style>
