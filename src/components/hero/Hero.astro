---
import Boton from '../atoms/Boton.astro';
---

<section class="hero">
	<div class="hero__container">
		<div class="text__content">
			<p class="hero__text">Hi there!</p>
			<h1 class="hero__title color__gradiente">I'm Oliver Modesto</h1>
			<div class="typing-container">
				<span class="hero__text" id="animate-typing"></span>
			</div>
			<Boton
				href="https://calendar.app.google/1FdB15EuStJZwGUT9"
				texto="Meet with me"
			/>
		</div>
		<div class="hero__carousel">
			<img
				class="carousel-img"
				src="/img/code2.webp"
				alt="JavaScript code example displaying an async data request"
				width="776"
				height="395"
				loading="eager"
				fetchpriority="high"
				decoding="async"
			/>
			<img
				class="carousel-img"
				src="/img/code3.webp"
				alt="Code example in a browser-style window"
				width="666"
				height="376"
				loading="lazy"
				decoding="async"
			/>
			<img
				class="carousel-img"
				src="/img/code4.webp"
				alt="Code example in a browser-style window"
				width="624"
				height="376"
				loading="lazy"
				decoding="async"
			/>
			<!-- Add more images as needed -->
		</div>
	</div>
</section>

<script>
	import {
		typeErase,
		updateCarousel,
	} from '../../utils/animations/hero-animation.js';

	document.addEventListener('DOMContentLoaded', () => {
		// Initialize typing animation
		typeErase();

		// Initialize carousel
		const firstImage = document.querySelector('.carousel-img');
		if (firstImage) {
			firstImage.classList.add('active');
		}
		updateCarousel();

		// Set up carousel rotation
		setInterval(() => {
			const carouselImgs = document.querySelectorAll('.carousel-img');
			let activeIndex = Array.from(carouselImgs).findIndex((img) =>
				img.classList.contains('active'),
			);
			carouselImgs[activeIndex].classList.remove('active');
			activeIndex = (activeIndex + 1) % carouselImgs.length;
			carouselImgs[activeIndex].classList.add('active');
			updateCarousel();
		}, 5000);
	});
</script>

<style>
	.hero {
		padding: 12rem 2.2rem 5rem;
		width: 100%;
		min-height: 100dvh;
		background: var(--hero-bg);
		animation: presentation 3s linear forwards;
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		color: var(--on-primary);
	}

	.hero::after {
		content: '';
		position: absolute;
		height: 6rem;
		width: 100%;
		background: linear-gradient(0deg, var(--primary-0), transparent);
		bottom: 0;
	}

	.hero .hero__container {
		width: 100%;
		max-width: var(--max-width);
		display: flex;
		flex-direction: column-reverse;
		gap: 4rem;
		padding: 1rem;
		align-items: center;
	}

	.hero__container .text__content {
		font-weight: 600;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: center;
		text-align: center;
		width: 100%;
	}

	.hero .hero__text {
		font-size: var(--text-xx-large);
	}

	.hero__container .text__content .hero__title {
		font-size: clamp(2rem, 5vw, 3.5rem);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 100%;
		line-height: 1.2;
		margin: 0;
	}

	.typing-container {
		height: 2.5em;
		display: flex;
		align-items: center;
		margin: 0.5rem 0;
	}

	#animate-typing {
		min-height: 1.2em;
		display: inline-block;
	}

	.hero__carousel {
		position: relative;
		width: 100%;
		max-width: 90%;
		aspect-ratio: 16/10;
		overflow: hidden;
		border-radius: 20px;
		background: var(--primary-900);
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
		transform: perspective(1000px) rotateY(-5deg);
		transition: all 0.3s ease;
	}

	.hero__carousel::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 40px;
		background: linear-gradient(
			to bottom,
			var(--primary-800),
			var(--primary-900)
		);
		border-radius: 20px 20px 0 0;
		z-index: 3;
	}

	.hero__carousel::after {
		content: '';
		position: absolute;
		top: 15px;
		left: 20px;
		width: 12px;
		height: 12px;
		background: #ff5f57;
		border-radius: 50%;
		box-shadow:
			20px 0 0 #ffbd2e,
			40px 0 0 #28c941;
		z-index: 4;
	}

	.carousel-img {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transform: scale(0.95) translateX(50px);
		filter: brightness(0.8) contrast(1.2);
		transition: all 0.8s cubic-bezier(0.4, 0.1, 0.2, 1);
		pointer-events: none;
		padding-top: 40px;
	}

	.carousel-img.active {
		opacity: 1;
		transform: scale(1) translateX(0);
		filter: brightness(1) contrast(1.1);
		z-index: 2;
	}

	.carousel-img.prev {
		transform: scale(0.95) translateX(-50px);
		opacity: 0;
		filter: brightness(0.7) blur(2px);
		z-index: 1;
	}

	.carousel-img.next {
		transform: scale(0.95) translateX(50px);
		opacity: 0;
		filter: brightness(0.7) blur(2px);
		z-index: 1;
	}

	.hero__carousel:hover {
		transform: perspective(1000px) rotateY(-2deg) translateY(-5px);
		box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
	}

	@media (min-width: 768px) {
		.hero {
			padding: 6rem 2.2rem 0;
		}

		.hero .hero__container {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 4rem;
			padding: 2rem;
			align-items: center;
		}

		.hero__container .text__content {
			align-items: flex-start;
			text-align: left;
		}

		.hero__carousel {
			max-width: 600px;
		}
	}

	@media (min-width: 1024px) {
		.hero__carousel {
			max-width: 700px;
		}
	}

	@media (min-width: 1280px) {
		.hero .hero__container {
			grid-template-columns: 1fr 1.5fr;
			gap: 6rem;
			padding: 2rem 4rem;
		}

		.hero__carousel {
			max-width: 800px;
		}
		.hero .hero__text {
			font-size: var(--text-x-large);
			text-align: center;
		}
	}

	@keyframes presentation {
		0% {
			background-size: 200%;
		}
		50% {
			background-position: 70%;
		}
		100% {
			background-size: 100%;
		}
	}
</style>
