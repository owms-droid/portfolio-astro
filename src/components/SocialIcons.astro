---
import { siteConfig } from '../config/site.js';
import Icon from './Icon.astro';
const { width, height } = Astro.props;

const { socialLinks } = siteConfig;
---

<div class="icons__container">
	{socialLinks.map((data) => (
		<a href={data.href} target="_blank" rel="nofollow noreferrer noopener">
			<Icon
				name={data.icon}
				width={width}
				height={height}
				class={`skill__icon ${data.title}`}
			/>
		</a>
	))}
</div>

<style>
	.icons__container {
		display: flex;
		width: 29.6rem;
		/* padding: 1.3rem 4rem; */
		justify-content: flex-start;
		align-items: flex-start;
		gap: 2rem;
	}
	.icons__container :global(.skill__icon) {
		color: #dcd8fc;
	}

	.icons__container :global(.LinkedIn:hover) {
		color: #0e76a8;
	}
	.icons__container :global(.Instagram:hover) {
		color: #e1306c;
	}
	.icons__container :global(.Twitter:hover) {
		color: #0aa5f6;
	}
	.icons__container :global(.CV:hover) {
		color: #8e64ff;
	}
</style>
