---
import Logo from '../Logo.astro';
import SocialIcons from '../SocialIcons.astro';
import Icon from '../Icon.astro';
---

<footer>
	<div class="footer__container">
		<Logo name="owiDev" />
		<SocialIcons width="23" height="23" />
	</div>

	<aside class="footer__links">
		<ul>
			<!-- <li>
				<a class="footer__link" href="mailto:biztum.marketing@gmail.com"
					><span
						><Icon
							name="fluent:mail-28-regular"
							width="27"
							height="27"
							style="color: #dcd8fc"
						/></span
					>biztum.marketing@gmail.com</a>
			</li> -->
			<li>
				<a
					class="footer__link"
					href="https://github.com/owms-droid"
					target="_blank"
					rel="nofollow noreferrer noopener"
				>
					<span>
						<Icon
							name="mdi:github"
							width="27"
							height="27"
							style="color: #dcd8fc"
						/>
					</span>
					@owiDev
				</a>
			</li>
		</ul>
	</aside>
</footer>

<style>
	footer {
		width: 100%;
		background: rgb(19, 19, 19);
		display: flex;
		justify-content: space-between;
		min-height: 20dvh;
		color: var(--primary-100);
		align-items: center;
		padding: 1rem 4rem;
		flex-wrap: wrap;
	}
	footer :global(h3) {
		font-size: var(--text-title);
	}

	.footer__container {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 2rem;
	}

	.footer__link {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 1rem;
		font-size: var(--text-large);
	}
</style>
