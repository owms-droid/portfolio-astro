---
import './card-portfolio.css';
import Icon from '../Icon.astro';

const {
	title,
	descripcion,
	imgSrc,
	skills,
	repoURL,
	demoURL,
	averageBrightness,
} = Astro.props;
---

<div class="card__portfolio">
	<img
		src={imgSrc}
		alt={title}
		crossorigin="anonymous"
		height={130}
		width={332}
		loading="lazy"
		average-brightness={averageBrightness}
	/>

	<div class="descripcion__container">
		<h2 class="card__title">{title}</h2>
		<div class="descripcion">
			<p>{descripcion}</p>

			<div class="skills">
				{
					skills.map((skill: string) => (
						<Icon class="iconify" name={skill} />
					))
				}
			</div>

			<div class="buttons">
				{repoURL && (
					<a href={repoURL} target="_blank" rel="noopener noreferrer" aria-label={`View GitHub repository for ${title}`}>
						<span>
							Github
							<Icon name="quill:link-out" />
						</span>
					</a>
				)}

				{demoURL && (
					<a href={demoURL} target="_blank" rel="noopener noreferrer" aria-label={`View live demo of ${title}`}>
						<span>
							Demo
							<Icon name="quill:link-out" />
						</span>
					</a>
				)}
			</div>
		</div>
	</div>
</div>